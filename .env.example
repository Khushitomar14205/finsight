# FinSight configuration — copy to .env and fill in. Never commit .env.
# LLM provider: gemini | openai | none  (none = full local analytics, rule-based agent)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
LLM_MODEL=gemini-2.0-flash
# Optional external news provider (not required for historical analytics)
NEWS_API_KEY=
# Application
RISK_FREE_RATE=0.06
TRADING_DAYS_PER_YEAR=252
FINSIGHT_DATA_DIR=data
